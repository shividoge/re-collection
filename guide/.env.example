PORT=8787
ANTHROPIC_API_KEY=
MODEL_OFFLINE=claude-opus-5-5
MODEL_LIVE=claude-sonnet-5-5
# If set, every route except /health needs header X-Braindance-Key (or ?key= on /files URLs).
BRAINDANCE_KEY=
# 1 = canned "[mock]" replies for UI work without a key. Never in the demo.
MOCK_CLAUDE=0
DATA_DIR=./data
# Live visit calls: JSON array of ICE servers. Empty = a public STUN server; add a TURN server to
# get calls through networks that block direct ones (otherwise voice is relayed by the guide).
ICE_SERVERS=
